{
  "$schema": "node_modules/wrangler/config-schema.json",
  "compatibility_date": "2026-05-17",
  "name": "skland-daily-attendance",
  "compatibility_flags": ["nodejs_als"],
  "observability": {
    "enabled": true
  },
  "kv_namespaces": [
    {
      "binding": "KV"
    }
  ],
  "triggers": {
    // 每日北京时间 00:30（16:30 UTC）；第二个为临时测试触发器，验证后删除
    "crons": ["30 16 * * *", "*/5 * * * *"]
  }
}
